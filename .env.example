# Browser (public by design)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Local development only: the browser calls Meta directly. Never set this on a deployment.
VITE_MUSE_API_KEY=your-meta-model-api-key
# Optional, defaults to https://api.meta.ai/v1
VITE_META_API_BASE_URL=

# Server only (Vercel environment variables). Never prefix these with VITE_.
MUSE_API_KEY=your-meta-model-api-key
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ROPI_LLM_SECRET=
